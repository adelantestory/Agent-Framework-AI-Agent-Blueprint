# Azure OpenAI Configuration
# Replace these values with your actual Azure OpenAI resource details

# Your Azure OpenAI endpoint URL
# Find this in Azure Portal -> Your OpenAI Resource -> Keys and Endpoint
# Format: https://YOUR-RESOURCE-NAME.openai.azure.com
#AZURE_OPENAI_ENDPOINT=https://testasf-azure-openai.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Your model deployment name
# This is the name you gave when deploying the model in Azure OpenAI Studio
# Common names: gpt-4o, gpt-4, gpt-35-turbo
#AZURE_OPENAI_DEPLOYMENT=testasfplayground
AZURE_OPENAI_DEPLOYMENT=

# API Key (optional - only needed if not using Azure CLI credentials)
# Find this in Azure Portal -> Your OpenAI Resource -> Keys and Endpoint
#AZURE_OPENAI_API_KEY=9d303197fd794dc59049a51c76ddf5df
AZURE_OPENAI_API_KEY=

# Court Listener API Authorization Token
COURTLISTENER_API_TOKEN=

# Observability through Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
ENABLE_OBSERVABILITY=

# RentCast API Key
# Sign up at https://developers.rentcast.io/ to get your API key
RENTCAST_API_KEY=

# Model Provider Selection & Ollama Configurations
MODEL_PROVIDER=
OLLAMA_ENDPOINT=
OLLAMA_MODEL_NAME=

# Tavily API Key
TAVILY_API_KEY=

# Azure OpenAI Embeddings Configuration (for RAG/Knowledge Base)
AZURE_OPENAI_EMBEDDINGS_ENDPOINT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_API_KEY=

# Qdrant Vector Database (purchased via Azure Marketplace)
# Your cluster endpoint URL from Azure Portal (should include https:// and :6333 port)
# Example: https://abc123xyz.qdrant.io:6333
QDRANT_URL=

# Your API key from Azure Portal
QDRANT_API_KEY=

# Collection name (you can keep this default or change it)
QDRANT_COLLECTION_NAME=